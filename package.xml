<?xml version="1.0"?>
<package format="3">
  <name>ndt_localization</name>
  <version>0.2.0</version>
  <description>Autoware-style NDT scan matcher (vendored multigrid ndt_omp) for a fixed 3D map, fused with wheel/IMU odometry by a map-frame robot_localization EKF.</description>
  <maintainer email="takumi@example.com">takumi</maintainer>
  <license>Apache-2.0</license>
  <license>BSD-2-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>tf2</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>eigen</depend>
  <depend>libboost-dev</depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>tf2_ros_py</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
